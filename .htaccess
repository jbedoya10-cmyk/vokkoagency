Options -Indexes
RewriteEngine On

# Force HTTPS (uncomment when SSL is active)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Canonical: redirect bare root to /inicio ──
RewriteRule ^$ /inicio [R=301,L]

# ── Canonical: redirect .html URLs to clean URLs ──
RewriteRule ^index\.html$ /inicio [R=301,L]
RewriteRule ^servicios\.html$ /servicios [R=301,L]
RewriteRule ^proyectos\.html$ /proyectos [R=301,L]
RewriteRule ^nosotros\.html$ /nosotros [R=301,L]
RewriteRule ^contacto\.html$ /contacto [R=301,L]

# ── Internal rewrites: serve .html files for clean URLs ──
RewriteRule ^inicio/?$ /index.html [L]
RewriteRule ^servicios/?$ /servicios.html [L]
RewriteRule ^proyectos/?$ /proyectos.html [L]
RewriteRule ^nosotros/?$ /nosotros.html [L]
RewriteRule ^contacto/?$ /contacto.html [L]

# ── Custom 404 (optional) ──
# ErrorDocument 404 /inicio
